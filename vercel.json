{
  "rewrites": [
    { "source": "/coninte", "destination": "/coninte/page.html" },
    { "source": "/tec", "destination": "/tec/page.html" },
    { "source": "/", "destination": "https://orquestialab.marblism.me/" },
    { "source": "/nosotros", "destination": "https://orquestialab.marblism.me/nosotros" },
    { "source": "/soluciones", "destination": "https://orquestialab.marblism.me/soluciones" },
    { "source": "/proceso", "destination": "https://orquestialab.marblism.me/proceso" },
    { "source": "/proyectos", "destination": "https://orquestialab.marblism.me/proyectos" },
    { "source": "/contacto", "destination": "https://orquestialab.marblism.me/contacto" },
    { "source": "/sitemap.xml", "destination": "https://orquestialab.marblism.me/sitemap.xml" },
    { "source": "/favicon.svg", "destination": "https://orquestialab.marblism.me/favicon.svg" },
    { "source": "/orquestialab-logo.png", "destination": "https://orquestialab.marblism.me/orquestialab-logo.png" },
    { "source": "/_astro/:path*", "destination": "https://orquestialab.marblism.me/_astro/:path*" },
    { "source": "/images/:path*", "destination": "https://orquestialab.marblism.me/images/:path*" }
  ],
  "headers": [
    {
      "source": "/(coninte|tec)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(coninte|tec)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
