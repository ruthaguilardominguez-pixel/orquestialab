{
  "rewrites": [
    { "source": "/coninte", "destination": "/coninte/page.html" },
    { "source": "/tec", "destination": "/tec/page.html" }
  ],
  "headers": [
    {
      "source": "/(coninte|tec)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(coninte|tec)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
