---
import Layout from '../layouts/Layout.astro';

const pasos = [
  { num: '01', titulo: 'Te escuchamos', texto: 'Entendemos el problema detrás de la herramienta que hoy estás buscando.' },
  { num: '02', titulo: 'Encontramos el foco', texto: 'Ponemos nombre al punto donde una mejora puede cambiar tu operación.' },
  { num: '03', titulo: 'Te decimos cómo', texto: 'Saldrás con claridad sobre qué hacer después, empieces con nosotros o no.', destacado: true },
];
---
<Layout
  title="Contacto | OrquestiaLab"
  description="Cuéntanos cómo funciona tu negocio y agenda un diagnóstico con OrquestiaLab."
  path="/contacto"
>
  <section class="seccion-papel">
    <div class="contenedor" style="display:grid; gap:40px; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); align-items:start;">
      <div>
        <p class="cuerpo texto-suave">Contacto</p>
        <h1 class="titulo-1" style="margin-top:8px;">Hablemos de cómo trabaja <span class="caja" style="white-space:nowrap;">tu negocio</span>.</h1>
        <p class="cuerpo-grande texto-suave" style="margin-top:16px;">Cuéntanos qué está pasando hoy en tu operación. Te responderemos para encontrar juntos un punto de partida claro.</p>
        <div style="margin-top:32px;">
          <p class="cuerpo texto-suave">También puedes escribirnos</p>
          <p class="cuerpo" style="margin-top:4px;"><a href="mailto:vamos@orquestialab.com" class="enlace">vamos@orquestialab.com</a></p>
        </div>
      </div>

      <form id="contact-form" class="tarjeta panel" style="padding:32px;">
        <div style="display:flex; justify-content:space-between; gap:12px;">
          <div>
            <p class="marca-etiqueta" style="color:var(--oliva-700);">Agendar diagnóstico</p>
            <h2 class="titulo-2" style="margin-top:8px;">Cuéntanos un poco más.</h2>
          </div>
          <span aria-hidden="true" style="font-size:22px; color:var(--oliva-700);">↗</span>
        </div>

        <div style="display:grid; gap:20px; margin-top:32px; grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
          <label class="campo" for="name">Nombre completo
            <input id="name" name="name" type="text" autocomplete="name" required placeholder="Tu nombre" />
          </label>
          <label class="campo" for="company">Empresa
            <input id="company" name="company" type="text" autocomplete="organization" required placeholder="Tu empresa" />
          </label>
          <label class="campo" for="email">Email
            <input id="email" name="email" type="email" autocomplete="email" required placeholder="tu@empresa.com" />
          </label>
          <label class="campo" for="phone">Teléfono
            <input id="phone" name="phone" type="tel" autocomplete="tel" required placeholder="55 0000 0000" />
          </label>
          <label class="campo" for="role">Cargo
            <select id="role" name="role" required>
              <option value="" selected disabled>Selecciona una opción</option>
              <option>CEO / Fundador</option>
              <option>Director de Operaciones</option>
              <option>Director de Tecnología</option>
              <option>Director Comercial</option>
              <option>Otro</option>
            </select>
          </label>
          <label class="campo" for="need">¿Qué necesitas?
            <select id="need" name="need" required>
              <option value="" selected disabled>Selecciona una opción</option>
              <option>Diagnosticar mi operación</option>
              <option>Automatizar tareas</option>
              <option>Construir software a medida</option>
              <option>Evolucionar un sistema existente</option>
            </select>
          </label>
          <fieldset style="grid-column:1/-1; border:0; padding:0; margin:0;">
            <legend class="campo" style="margin-bottom:8px;">Presupuesto estimado</legend>
            <div class="grupo-radio" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); display:grid;">
              <label class="opcion"><input type="radio" name="budget" value="Menos de $50K MXN" required /> Menos de $50K MXN</label>
              <label class="opcion"><input type="radio" name="budget" value="$50K - $150K MXN" /> $50K - $150K MXN</label>
              <label class="opcion"><input type="radio" name="budget" value="$150K - $500K MXN" /> $150K - $500K MXN</label>
              <label class="opcion"><input type="radio" name="budget" value="Más de $500K MXN" /> Más de $500K MXN</label>
            </div>
          </fieldset>
          <label class="campo" style="grid-column:1/-1;" for="message">Mensaje
            <textarea id="message" name="message" rows="5" required placeholder="Cuéntanos cómo funciona hoy tu operación..."></textarea>
          </label>
        </div>

        <button id="contact-submit" type="submit" class="btn-principal enlace-flecha" style="margin-top:32px; width:100%; justify-content:center; display:inline-flex;">
          Enviar mensaje <span aria-hidden="true">→</span>
        </button>
        <p id="contact-status" class="cuerpo texto-suave" style="margin-top:12px; min-height:24px;" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="seccion-blanca">
    <div class="contenedor" style="display:grid; gap:16px; grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
      {pasos.map((p) => (
        <div class="tarjeta" style={p.destacado ? 'background:var(--lima-500); color:var(--tinta-900); border:0;' : ''}>
          <p class="cuerpo" style="font-weight:600;">{p.num}</p>
          <h2 class="titulo-3" style="margin-top:32px;">{p.titulo}</h2>
          <p class={`cuerpo ${p.destacado ? '' : 'texto-suave'}`} style="margin-top:12px;">{p.texto}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector('#contact-form') as HTMLFormElement | null;
  const btn = document.querySelector('#contact-submit') as HTMLButtonElement | null;
  const status = document.querySelector('#contact-status') as HTMLParagraphElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !btn || !status) return;
    btn.disabled = true;
    status.textContent = 'Enviando tu mensaje…';
    status.style.color = '';
    try {
      const data = Object.fromEntries(new FormData(form).entries());
      const res = await fetch('/api/sendEmail', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || 'No pudimos enviar el mensaje.');
      form.reset();
      status.textContent = 'Gracias. Recibimos tu mensaje y te contactaremos pronto.';
      status.style.color = 'var(--oliva-700)';
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : 'No pudimos enviar el mensaje. Inténtalo de nuevo en un momento.';
      status.style.color = 'var(--error)';
    } finally {
      btn.disabled = false;
    }
  });
</script>
