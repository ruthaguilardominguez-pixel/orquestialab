---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function escapeHtml(s: string) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
const safeTitle = escapeHtml(post.data.title);
const titleHtml = post.data.cajaWord
  ? safeTitle.replace(new RegExp(`(${post.data.cajaWord})`, 'i'), '<span class="caja">$1</span>')
  : safeTitle;
---
<Layout
  title={`${post.data.title} | Blog | OrquestiaLab`}
  description={post.data.description}
  path={`/blog/${post.slug}`}
  ogImage={post.data.image}
  ogType="article"
>
  <article class="seccion-papel articulo">
    <div class="contenedor" style="max-width:720px;">
      <a href="/blog" class="enlace enlace-flecha"><span aria-hidden="true">←</span> Volver al blog</a>
      <header style="margin-top:24px;">
        <p class="cuerpo texto-suave">{post.data.pubDate.toISOString().slice(0, 10)}</p>
        <h1 class="titulo-1" style="margin-top:12px;" set:html={titleHtml} />
      </header>
      <div class="cuerpo-grande" style="margin-top:32px;">
        <Content />
      </div>
    </div>
  </article>
</Layout>
