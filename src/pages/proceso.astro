---
import Layout from '../layouts/Layout.astro';

const pasos = [
  { num: '01', titulo: 'Analizamos', sub: 'La operación antes que la herramienta.', texto: 'Nos sentamos con quienes conocen el negocio. Revisamos cómo entra, se transforma y sale la información; qué se repite, qué se retrasa y qué depende demasiado de una sola persona.' },
  { num: '02', titulo: 'Diseñamos', sub: 'Un plan que el equipo pueda hacer suyo.', texto: 'Traducimos lo observado en prioridades concretas. Definimos qué resolver primero, cómo se medirá y qué experiencia necesita cada persona para usar la solución sin fricción.' },
  { num: '03', titulo: 'Digitalizamos', sub: 'Procesos claros en herramientas simples.', texto: 'Convertimos los pasos clave en una experiencia digital. Construimos por etapas para que tu negocio empiece a ver valor pronto, sin detener la operación.' },
  { num: '04', titulo: 'Automatizamos', sub: 'Menos tareas repetitivas, más capacidad.', texto: 'Conectamos reglas, avisos y acciones que antes se hacían manualmente. El equipo recupera tiempo para atender clientes, resolver problemas y crecer.' },
  { num: '05', titulo: 'Conectamos', sub: 'Una vista común para decidir mejor.', texto: 'Integramos fuentes y resultados en dashboards que hablan el idioma del negocio. La información llega a la persona correcta, cuando hace falta.' },
];
---
<Layout
  title="Proceso | OrquestiaLab"
  description="Conoce el método de OrquestiaLab: analizamos, diseñamos, digitalizamos, automatizamos y conectamos la operación de tu negocio."
  path="/proceso"
>
  <section class="seccion-papel">
    <div class="contenedor">
      <p class="cuerpo texto-suave">Nuestro proceso</p>
      <h1 class="titulo-1" style="margin-top:8px; max-width:640px;">Ordenamos lo complejo <span class="caja" style="white-space:nowrap;">paso a paso</span>.</h1>
      <p class="cuerpo-grande texto-suave" style="margin-top:16px; max-width:600px;">La transformación de un negocio no sucede de golpe. La construimos contigo, empezando por lo que más impacto tiene hoy.</p>

      <div style="display:grid; gap:20px; margin-top:48px;">
        {pasos.map((p) => (
          <article class="tarjeta" style="display:grid; gap:16px; grid-template-columns:60px 1fr 2fr; align-items:start;">
            <span class="marca-numero" style="font-size:32px; color:var(--oliva-700);">{p.num}</span>
            <div>
              <h2 class="titulo-3">{p.titulo}</h2>
              <p class="cuerpo" style="font-weight:600; margin-top:4px;">{p.sub}</p>
            </div>
            <p class="cuerpo texto-suave">{p.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion-lima sobre-lima">
    <div class="contenedor" style="text-align:center;">
      <p class="marca-etiqueta">Una conversación para comenzar</p>
      <h2 class="titulo-1" style="margin-top:16px;">Tu operación ya te está diciendo <span class="caja" style="white-space:nowrap;">por dónde empezar</span>.</h2>
      <a href="/contacto" class="btn-secundario enlace-flecha" style="margin-top:24px; display:inline-flex; background:var(--tinta-900); color:var(--lima-500); border:0;">Hablemos de tu negocio <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
