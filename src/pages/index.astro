---
import Layout from '../layouts/Layout.astro';

const industrias = ['Construcción', 'Retail y comercio', 'Deportes y entretenimiento', 'Servicios profesionales', 'Salud', 'Educación', 'Logística', 'Gastronomía'];

const formas = [
  { num: '01', titulo: 'CONSULTORÍA Y DIAGNÓSTICO', tag: 'Pymes · Enterprise', intro: 'Para empresas que necesitan certeza antes de invertir', items: ['Mapeo de procesos y fricción operativa', 'Diagnóstico de dónde se pierde tiempo y dinero', 'Backlog priorizado con ROI estimado', 'Evaluación de qué automatizar y qué no', 'Roadmap claro antes de escribir una línea de código'], cierre: 'Certeza antes de invertir.' },
  { num: '02', titulo: 'AUTOMATIZACIÓN E INTELIGENCIA ARTIFICIAL', tag: 'Pymes · Enterprise', intro: 'Para operaciones con tareas repetitivas y cuellos de botella', items: ['Automatizaciones en producción en semanas, no meses', 'Conexión con las herramientas que ya usas (WhatsApp, Excel, ERP, CRM)', 'Agentes de IA entrenados con los datos reales de tu negocio', 'Registro y seguimiento sin capturar dos veces', 'Adopción sin fricción para el equipo'], cierre: 'Tu operación conectada y sin trabajo repetitivo.' },
  { num: '03', titulo: 'SOFTWARE A MEDIDA', tag: 'Startups · Pymes · Enterprise', intro: 'Para construir el sistema exacto que tu negocio necesita', items: ['Plataforma lista por fases, con entregas continuas', 'Diseño pensado para que tu equipo de verdad la use', 'Dashboards e indicadores del negocio en un solo lugar', 'Escalable cuando el negocio crece', 'Sin deuda técnica y con soporte real'], cierre: 'El sistema que se adapta a tu negocio, no al revés.' },
  { num: '04', titulo: 'EVOLUCIÓN CONTINUA', tag: 'Pymes · Enterprise', intro: 'Para negocios que ya tienen sistemas y quieren mejorarlos', items: ['Roadmap vivo de 6 o 12 meses', 'Mejoras continuas cada sprint', 'Nuevos módulos según lo que pida la operación', 'Analítica y reportes que evolucionan con el negocio', 'Acompañamiento consultivo, no solo soporte'], cierre: 'Tu sistema mejora mes con mes.' },
];

const capacidades = [
  { titulo: 'Procesos y diagnóstico operativo', items: ['Mapa de operación', 'Fricciones visibles', 'Prioridades claras'] },
  { titulo: 'Desarrollo web y apps a medida', items: ['Experiencias simples', 'Entregas por fases', 'Arquitectura escalable'] },
  { titulo: 'Agentes de IA y automatización', etiqueta: 'IMPULSADO POR IA', items: ['Flujos conectados', 'Datos reales del negocio', 'Adopción sin fricción'] },
  { titulo: 'Datos, dashboards y analítica', items: ['Indicadores clave', 'Una sola vista', 'Decisiones a tiempo'] },
  { titulo: 'Integraciones con WhatsApp, Excel, ERP y CRM', items: ['Herramientas conectadas', 'Menos captura doble', 'Información en contexto'] },
  { titulo: 'Seguridad, respaldo y continuidad', items: ['Datos protegidos', 'Respaldos confiables', 'Operación preparada'] },
];

const pasos = [
  { num: '01', titulo: 'Analizamos', texto: 'Entendemos tu operación, tus datos y los puntos donde el día a día se atora.' },
  { num: '02', titulo: 'Diseñamos', texto: 'Convertimos los hallazgos en un plan simple, medible y alineado a tu negocio.' },
  { num: '03', titulo: 'Digitalizamos', texto: 'Llevamos tus procesos clave a herramientas que tu equipo sí puede usar.' },
  { num: '04', titulo: 'Automatizamos', texto: 'Quitamos trabajo repetitivo para que las personas se enfoquen en hacer crecer el negocio.' },
  { num: '05', titulo: 'Conectamos', texto: 'Integramos la información para que una sola vista te ayude a decidir mejor.' },
];

const proyectos = [
  {
    num: '01',
    titulo: 'Cimiento',
    cliente: 'AVM · Arquitectura y Construcción',
    texto: 'El arquitecto Erick necesitaba dejar PlanRadar: ninguna plataforma del mercado cubría todo lo que su obra requería, y hacer software a medida significaba cotizaciones altísimas y un programador de planta. Así nació Cimiento, un SaaS de gestión de obra que hoy opera su despacho, de la oficina a la obra.',
    links: [
      { label: 'Conoce Cimiento', href: 'https://www.cimiento.build/' },
      { label: 'Entrar a la app', href: 'https://app.cimiento.build/' },
    ],
  },
  {
    num: '02',
    titulo: 'Concilia',
    cliente: 'Nuestros restaurantes',
    texto: 'Nació en nuestros propios restaurantes. Necesitábamos que la operación corriera sola: cierre contable, compras y lista de compras, reportes de limpieza y producción, costeo de recetas e inventarios. El punto de venta que usábamos, uno de los más conocidos en México y Latinoamérica, tomó nuestro dashboard como punto de partida para sus mejoras en inventarios. Hoy Concilia se comercializa en México y Colombia.',
    links: [{ label: 'Conoce Concilia', href: 'https://concilia.orquestialab.com/' }],
  },
  {
    num: '03',
    titulo: 'Orquestia CRM',
    cliente: 'Operación de dos SaaS de suscripción',
    texto: 'Hay muchos CRMs que siguen cada lead a la perfección, pero ¿cubren todo lo que necesitas? Aquí la necesidad era doble: una vista 360 de cada cuenta y administrar dos SaaS de suscripción desde un solo lugar. Hoy, en un único sistema, se entra a una cuenta, se ve su historial, se activa o desactiva y se revisan sus pagos y facturas, y todo se sincroniza automáticamente con ambos softwares.',
    links: [{ label: 'Conoce Orquestia CRM', href: 'https://crm.orquestialab.com/' }],
  },
  {
    num: '04',
    titulo: 'Orquestia CX + Admin web',
    cliente: 'Ostara · Clínica de fertilidad',
    texto: 'Ostara quería escuchar a sus pacientes y convertir lo que oía en mejoras visibles en su sitio. Le construimos un solo acceso donde ve las visitas y el SEO de su página, revisa los contactos registrados, aprueba y publica reseñas en su web, consulta sus finanzas al día alimentadas por un bot de WhatsApp y analiza todas las respuestas de su encuesta de CX.',
    links: [],
  },
];

const equipo = [
  { inicial: 'R', nombre: 'Ruth Aguilar', rol: 'Co-founder', bio: 'Operación, procesos y experiencia de cliente.' },
  { inicial: 'H', nombre: 'Hector Cepeda', rol: 'Co-founder', bio: 'Estrategia, producto y crecimiento sostenible.' },
  { inicial: 'G', nombre: 'Gandalf', rol: 'CMO', bio: 'Marketing, marca, crecimiento y posicionamiento.' },
];

const faqs = [
  { q: '¿En qué se diferencia OrquestiaLab de una agencia de software?', a: 'No entregamos un proyecto y desaparecemos. Entendemos la operación, construimos lo que realmente necesita tu negocio y acompañamos su evolución.' },
  { q: '¿Trabajan con negocios pequeños o solo con empresas grandes?', a: 'Trabajamos con ambos: desde un negocio con una sola sucursal hasta empresas con varias. El punto de partida es la complejidad real de tu operación, no el tamaño de tu empresa.' },
  { q: '¿Necesito tener mis procesos documentados para empezar?', a: 'No. De hecho, ese suele ser el punto de partida. Observamos cómo trabaja tu equipo hoy para convertir la operación real en procesos claros.' },
  { q: '¿Cuánto tarda en verse resultado?', a: 'Los primeros resultados suelen verse en las primeras semanas, con un alcance por fases que permite avanzar sin detener la operación.' },
  { q: '¿Qué pasa con mis datos y los de mis clientes?', a: 'Se respaldan, se protegen y son tuyos. Nunca se usan para otra cosa.' },
];
---
<Layout
  title="OrquestiaLab | Tu operación, en un solo sistema"
  description="OrquestiaLab analiza, digitaliza y automatiza los procesos de negocios tradicionales para convertir información dispersa en decisiones claras."
  path="/"
>
  <section class="seccion-lima sobre-lima">
    <div class="contenedor">
      <p class="marca-etiqueta">Inteligencia de negocio + software a medida</p>
      <h1 class="display" style="margin-top:16px; max-width:820px;">Digitalizamos procesos, transformamos <span class="caja">industrias</span>.</h1>
      <p class="cuerpo-grande" style="max-width:640px; margin-top:24px;">Diseñamos e implementamos software, automatizaciones e inteligencia artificial a la medida para modernizar las operaciones de empresas en industrias tradicionales.</p>
      <a href="/contacto" class="btn-principal enlace-flecha" style="margin-top:32px;">Hablemos de tu negocio <span aria-hidden="true">→</span></a>

      <div class="tarjeta panel" style="margin-top:64px; background:var(--tinta-900); color:var(--lima-500); display:flex; gap:24px; flex-wrap:wrap;">
        <div class="chip" style="background:rgba(211,254,81,.15); color:var(--lima-500);"><span class="marca-etiqueta">AGENTE IA</span>&nbsp;· Activo</div>
        <div class="chip" style="background:rgba(211,254,81,.15); color:var(--lima-500);"><span class="marca-etiqueta">AUTOMATIZACIONES</span>&nbsp;· Corriendo 24/7</div>
        <div class="chip" style="background:rgba(211,254,81,.15); color:var(--lima-500);"><span class="marca-etiqueta">DATOS</span>&nbsp;· En tiempo real</div>
      </div>
    </div>
  </section>

  <section class="seccion-papel">
    <div class="contenedor">
      <p class="cuerpo texto-suave">Industrias donde hemos creado impacto</p>
      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:16px;">
        {industrias.map((i) => <span class="chip">{i}</span>)}
      </div>
    </div>
  </section>

  <section class="seccion-blanca">
    <div class="contenedor">
      <div style="display:flex; justify-content:space-between; align-items:flex-end; gap:24px; flex-wrap:wrap;">
        <div>
          <p class="cuerpo texto-suave">Cómo trabajamos contigo</p>
          <h2 class="titulo-1" style="margin-top:8px;">Cuatro formas de hacer avanzar <span class="caja" style="white-space:nowrap;">tu operación</span>.</h2>
        </div>
        <a href="/soluciones" class="enlace enlace-flecha">Ver soluciones <span aria-hidden="true">→</span></a>
      </div>
      <div style="display:grid; gap:20px; margin-top:40px; grid-template-columns:repeat(auto-fit,minmax(260px,1fr));">
        {formas.map((f) => (
          <article class="tarjeta">
            <p class="marca-etiqueta texto-suave">{f.num}</p>
            <h3 class="titulo-3" style="margin-top:12px;">{f.titulo}</h3>
            <span class="chip" style="margin-top:8px;">{f.tag}</span>
            <p class="cuerpo texto-suave" style="margin-top:16px;">{f.intro}</p>
            <ul class="lista-marcada" style="margin-top:12px;">
              {f.items.map((it) => <li><span class="marcador">+</span><span class="cuerpo">{it}</span></li>)}
            </ul>
            <p class="cuerpo" style="margin-top:16px; font-weight:600;">{f.cierre}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion-papel">
    <div class="contenedor">
      <p class="cuerpo texto-suave">Capacidades</p>
      <h2 class="titulo-1" style="margin-top:8px; max-width:640px;">Todo lo que necesitas para <span class="caja" style="white-space:nowrap;">operar mejor</span>.</h2>
      <p class="cuerpo-grande texto-suave" style="margin-top:16px; max-width:560px;">El conocimiento del negocio y la tecnología trabajan en el mismo sistema.</p>
      <div style="display:grid; gap:20px; margin-top:40px; grid-template-columns:repeat(auto-fit,minmax(260px,1fr));">
        {capacidades.map((c) => (
          <article class="tarjeta">
            {c.etiqueta && <span class="marca-etiqueta" style="color:var(--oliva-700);">{c.etiqueta}</span>}
            <h3 class="titulo-3" style="margin-top:8px;">{c.titulo}</h3>
            <ul class="lista-marcada" style="margin-top:12px;">
              {c.items.map((it) => <li><span class="cuerpo texto-suave">{it}</span></li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion-blanca">
    <div class="contenedor">
      <div style="display:flex; justify-content:space-between; align-items:flex-end; gap:24px; flex-wrap:wrap;">
        <div>
          <p class="cuerpo texto-suave">Nuestro proceso</p>
          <h2 class="titulo-1" style="margin-top:8px; max-width:560px;">De la operación dispersa a la <span class="caja">claridad</span>.</h2>
          <p class="cuerpo texto-suave" style="margin-top:12px; max-width:480px;">No empezamos por la tecnología. Empezamos por entender cómo trabaja tu equipo y qué necesitas para avanzar.</p>
        </div>
        <a href="/proceso" class="enlace enlace-flecha">Conoce nuestro método <span aria-hidden="true">→</span></a>
      </div>
      <ol style="display:grid; gap:20px; margin-top:40px; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); list-style:none;">
        {pasos.map((p) => (
          <li class="tarjeta">
            <span class="marca-numero" style="font-size:32px; color:var(--oliva-700);">{p.num}</span>
            <h3 class="titulo-3" style="margin-top:8px;">{p.titulo}</h3>
            <p class="cuerpo texto-suave" style="margin-top:8px;">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="seccion-papel">
    <div class="contenedor">
      <p class="cuerpo texto-suave">Lo que construimos</p>
      <h2 class="titulo-1" style="margin-top:8px; max-width:560px;">Algunas empresas que hemos <span class="caja">ayudado</span>.</h2>
      <p class="cuerpo-grande texto-suave" style="margin-top:16px; max-width:560px;">Sistemas vivos para equipos que necesitan operar con menos fricción y más información.</p>
      <div class="rejilla-empresas" style="display:grid; gap:20px; margin-top:40px; grid-template-columns:repeat(2,1fr);">
        {proyectos.map((p) => (
          <article class="tarjeta" style="display:flex; flex-direction:column;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
              <span class="marca-etiqueta texto-suave">{p.num}</span>
            </div>
            <h3 class="titulo-3" style="margin-top:12px;">{p.titulo}</h3>
            <p class="marca-etiqueta texto-suave" style="margin-top:6px;">{p.cliente}</p>
            <p class="cuerpo texto-suave" style="margin-top:12px; flex-grow:1;">{p.texto}</p>
            {p.links.length > 0 && (
              <div style="display:flex; flex-wrap:wrap; gap:16px; margin-top:16px;">
                {p.links.map((l) => (
                  <a class="enlace" href={l.href} target="_blank" rel="noopener noreferrer">{l.label} <span aria-hidden="true">→</span></a>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion-tinta">
    <div class="contenedor" style="display:grid; gap:40px; grid-template-columns:repeat(auto-fit,minmax(320px,1fr));">
      <div>
        <p class="texto-suave cuerpo">Antes</p>
        <h2 class="titulo-2" style="margin-top:8px;">Lo que suele <span class="caja">fallar</span> en tu operación.</h2>
        <ul class="lista-marcada" style="margin-top:20px;">
          <li><span class="marcador">—</span><span class="cuerpo">La información vive en WhatsApp, Excel y libretas.</span></li>
          <li><span class="marcador">—</span><span class="cuerpo">Cada sucursal trabaja con una versión distinta.</span></li>
          <li><span class="marcador">—</span><span class="cuerpo">Las decisiones dependen de intuición y reportes tardíos.</span></li>
          <li><span class="marcador">—</span><span class="cuerpo">El equipo repite tareas que podrían resolverse solas.</span></li>
        </ul>
      </div>
      <div>
        <p class="texto-suave cuerpo">Después</p>
        <h2 class="titulo-2" style="margin-top:8px;">Lo que obtienes <span class="caja" style="white-space:nowrap;">al final</span>.</h2>
        <ul class="lista-marcada" style="margin-top:20px;">
          <li><span class="marcador" style="color:var(--lima-500);">+</span><span class="cuerpo">Una operación visible, ordenada y fácil de entender.</span></li>
          <li><span class="marcador" style="color:var(--lima-500);">+</span><span class="cuerpo">Información conectada para decidir a tiempo.</span></li>
          <li><span class="marcador" style="color:var(--lima-500);">+</span><span class="cuerpo">Procesos que escalan junto con tu negocio.</span></li>
          <li><span class="marcador" style="color:var(--lima-500);">+</span><span class="cuerpo">Más foco en crecer, menos tiempo apagando fuegos.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="seccion-blanca">
    <div class="contenedor">
      <p class="cuerpo texto-suave">El equipo</p>
      <h2 class="titulo-1" style="margin-top:8px;">Personas que entienden <span class="caja" style="white-space:nowrap;">el negocio</span>.</h2>
      <div style="display:grid; gap:20px; margin-top:40px; grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
        {equipo.map((p) => (
          <article class="tarjeta">
            <div class="chip" style="width:48px; height:48px; justify-content:center; font-weight:700; font-size:18px; background:var(--lima-500); color:var(--tinta-900); border-radius:999px;">{p.inicial}</div>
            <h3 class="titulo-3" style="margin-top:16px;">{p.nombre}</h3>
            <p class="cuerpo" style="font-weight:600;">{p.rol}</p>
            <p class="cuerpo texto-suave" style="margin-top:4px;">{p.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion-papel">
    <div class="contenedor">
      <p class="cuerpo texto-suave">Preguntas frecuentes</p>
      <h2 class="titulo-1" style="margin-top:8px; max-width:640px;">Lo que suelen preguntarnos antes de <span class="caja" style="white-space:nowrap;">trabajar juntos</span>.</h2>
      <p class="cuerpo texto-suave" style="margin-top:8px;">Respuestas directas para empezar con claridad.</p>
      <div style="display:grid; gap:12px; margin-top:32px; max-width:760px;">
        {faqs.map((f) => (
          <details class="tarjeta">
            <summary style="cursor:pointer; display:flex; justify-content:space-between; gap:12px; font-weight:600;">
              <span>{f.q}</span>
              <span aria-hidden="true">+</span>
            </summary>
            <p class="cuerpo texto-suave" style="margin-top:12px;">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion-lima sobre-lima">
    <div class="contenedor" style="text-align:center;">
      <p class="marca-etiqueta">El siguiente paso</p>
      <h2 class="titulo-1" style="margin-top:16px;">No creemos en versiones finales.<br />Creemos en <span class="caja" style="white-space:nowrap;">evolución constante</span>.</h2>
      <p class="cuerpo-grande" style="margin-top:16px; max-width:560px; margin-inline:auto;">Cuéntanos cómo funciona hoy tu negocio. En una primera conversación encontraremos dónde empezar.</p>
      <a href="/contacto" class="btn-secundario enlace-flecha" style="margin-top:24px; display:inline-flex; background:var(--tinta-900); color:var(--lima-500); border:0;">Agendar diagnóstico <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
